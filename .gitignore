node_modules/
dist/
out/
*.vsix
*.tsbuildinfo
.DS_Store
.env

# Forensic run traces (ADR-023)
.cascade/

# Local scratch: downloaded material and one-off scripts, never committed
_temp/

# Local project workspaces created by @cascade/server at runtime
cascade-projects/
cascade-workspace/

# Eval run outputs (PLAN-eval): per-run results + traces; fixtures under eval/tasks ARE committed
eval/runs/
eval/design-review/

# Tier-2 external benchmarks (PLAN-eval): cloned suites + generated tasks + shared deps — never committed
eval/external/

# Eval/builder working copies (ADR-053 forensics: repo-local so OS temp-cleanup can never sweep a live run)
eval/.work/

# Server console logs (crash forensics; see start-cascade.cmd)
logs/

# Test apps BUILT BY the agent inside this repo (extension runs use the workspace as cwd; a web-builder
# project can be pointed here too). They are throwaway build outputs, not source — and keeping them
# untracked also stops a future agent run from dirtying the harness repo it is running in.
/focusflow/
/packages/orbit/

# Desktop build + packaging output (ADR-081 §7)
packages/desktop/dist/
packages/desktop/out/
packages/desktop/browsers/

# Design review artifacts (screenshots + reference contact sheets from the preset/look authoring loop).
# Regenerate any time by serving the template's demo/ gallery and re-capturing — 21MB of PNGs is not history.
eval/design-review/
