{
  "name": "@cascade/server",
  "version": "0.0.0",
  "description": "Cascade server — hosts @cascade/core and relays the ActivityEvent protocol over WebSocket. The remote frontend (web app) drives the SAME engine the extension drives in-process. (ADR-018)",
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arizeai/openinference-semantic-conventions": "^2.5.0",
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@cascade/app-protocol": "*",
    "@cascade/core": "*",
    "@cascade/storage": "*",
    "@cascade/storage-sqlite": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "dockerode": "^5.0.1",
    "playwright-core": "^1.61.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
