{
  "_comment": "Additive package.json fragment for the backend pack. applyPack MERGES these into the project's package.json (deps + scripts) without clobbering existing entries. Not a standalone package.json.",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host --port 5173\" \"tsx watch server/index.ts\"",
    "server": "tsx server/index.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "tsx": "^4.19.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "@types/express": "^4.17.21"
  }
}
