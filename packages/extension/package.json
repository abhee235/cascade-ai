{
  "name": "@cascade/extension",
  "displayName": "Cascade",
  "description": "Cascade — an Ollama-native AI coding agent.",
  "version": "0.0.0",
  "private": true,
  "publisher": "cascade-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cascade",
          "title": "Cascade",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cascade": [
        {
          "id": "cascade.view",
          "name": "Cascade",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Cascade",
      "properties": {
        "cascade.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai",
            "groq",
            "openrouter",
            "llamacpp",
            "anthropic"
          ],
          "default": "ollama",
          "description": "Model provider. ollama/openai/groq/openrouter/llamacpp are OpenAI-compatible; anthropic is not yet implemented."
        },
        "cascade.model": {
          "type": "string",
          "default": "qwen36-agentic:latest",
          "description": "Model id for the selected provider (for Ollama, must be installed: run `ollama list`)."
        },
        "cascade.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional base URL override. Leave empty to use the provider's default (e.g. Ollama → http://127.0.0.1:11434)."
        },
        "cascade.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for hosted providers (OpenAI, Groq, OpenRouter). Not needed for local Ollama/llama.cpp."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs && tailwindcss -i ui/styles.css -o dist/webview.css --minify",
    "watch": "node esbuild.mjs --watch"
  },
  "dependencies": {
    "@cascade/core": "*",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.5.0"
  }
}
