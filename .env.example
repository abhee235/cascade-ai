# Cascade server configuration — copy to .env (gitignored) and fill in what you use.
# Real environment variables always win over this file (so `CASCADE_MODEL=x npm run dev` still works).

# ── Provider ────────────────────────────────────────────────────────────────────────────────────────
# ollama (default, local) | openai | nvidia | groq | openrouter | llamacpp | any id + CASCADE_BASE_URL
CASCADE_PROVIDER=ollama
# Model id for the chosen provider. Defaults: ollama → qwen2.5-coder:latest, openai → gpt-5-mini.
# Other hosted providers have NO default — set one (NVIDIA ids are vendor-prefixed, see build.nvidia.com):
#CASCADE_MODEL=gpt-5-mini
#CASCADE_MODEL=moonshotai/kimi-k2-instruct
# Endpoint override — only needed for a custom OpenAI-compatible endpoint or a non-default port:
#CASCADE_BASE_URL=https://integrate.api.nvidia.com

# ── API keys (hosted providers only; local ollama/llamacpp need none) ──────────────────────────────
# The provider-specific var wins; CASCADE_API_KEY is the fallback for custom endpoints.
#OPENAI_API_KEY=sk-...
#NVIDIA_API_KEY=nvapi-...
#GROQ_API_KEY=gsk_...
#OPENROUTER_API_KEY=sk-or-...
#CASCADE_API_KEY=

# ── Compaction window ──────────────────────────────────────────────────────────────────────────────
# Hosted providers have no live window probe, so Cascade sizes compaction from a model→window map
# (kimi-k2 128k, qwen3-coder 256k, deepseek-v3 128k, …). Set this ONLY if your NIM/OpenRouter endpoint
# serves a different window than the model's native max. 0/unset ⇒ use the map, then an 8k default.
#CASCADE_CONTEXT_WINDOW=131072
# Compaction trigger as a fraction of the window (default 0.7). Hardware knob for partial-offload local
# setups: decode slows as context grows (measured 48→31 tok/s by 90k on a 16GB GPU), so a lower trigger
# (e.g. 0.5) keeps the working context in the fast range at the cost of more frequent summarization.
#CASCADE_COMPACT_RATIO=0.5

# ── Server (defaults shown) ────────────────────────────────────────────────────────────────────────
#CASCADE_PORT=4319
#CASCADE_PREVIEW_PORT=4320
#CASCADE_HOST=127.0.0.1
#CASCADE_SANDBOX=off
