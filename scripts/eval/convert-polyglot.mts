// scripts/eval/convert-polyglot.mts — Tier-2 (PLAN-eval): convert polyglot-benchmark exercises into
// our eval fixture format, so ONE runner drives both suites (run.mts --tasks-dir).
//
//   npx tsx scripts/eval/convert-polyglot.mts            # converts the JS track (the one this box can run)
//
// Per exercise (eval/external/polyglot-benchmark/<lang>/exercises/practice/<name>):
//   .docs/instructions.md (+ introduction/append) → the prompt
//   stub + spec + babel.config.js                 → repo/
//   .meta/config.json files.example               → solution/ (renamed onto files.solution) — this is what
//                                                   lets verify-fixtures prove every converted task is sound
//   a generated run-tests.mjs                     → repo/ — runs the SHARED jest with NODE_PATH set; needed
//                                                   because `NODE_PATH=x node …` is POSIX-only and our checks
//                                                   run through cmd.exe on Windows. Absolute paths are baked
//                                                   in, which is fine: eval/external/ is machine-local,
//                                                   gitignored, and regenerated by this script.
//
// Only JavaScript for now — the only toolchain on this box (checked). Other tracks (python/go/rust/java/cpp)
// need their toolchains or a Docker image; the converter's per-language table makes adding them additive.

import { cpSync, existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'

const ROOT = join(import.meta.dirname, '..', '..')
const BENCH = join(ROOT, 'eval', 'external', 'polyglot-benchmark')
const OUT = join(ROOT, 'eval', 'external', 'tasks-js')
const JS_DEPS = join(ROOT, 'eval', 'external', 'js-deps', 'node_modules')
const JEST = join(JS_DEPS, 'jest', 'bin', 'jest.js')

if (!existsSync(BENCH)) {
	console.error(`polyglot-benchmark not found — clone it first:\n  git clone --depth 1 https://github.com/Aider-AI/polyglot-benchmark.git ${BENCH}`)
	process.exit(2)
}
if (!existsSync(JEST)) {
	console.error(`shared js deps missing — run:  cd eval/external/js-deps && npm install`)
	process.exit(2)
}

// The per-repo test shim (protected in task.json): forwards to the SHARED jest with NODE_PATH set so the
// exercise's babel preset resolves without a per-task npm install. Exit code passes through.
const runTestsSource = `// run-tests.mjs — eval test shim (generated; do not modify). Runs the shared jest.
import { spawnSync } from 'node:child_process'
const r = spawnSync(process.execPath, [${JSON.stringify(JEST)}, '--rootDir', '.', '--colors=false', './'], {
	env: { ...process.env, NODE_PATH: ${JSON.stringify(JS_DEPS)} },
	stdio: 'inherit',
	shell: false,
})
process.exit(r.status ?? 1)
`

// Excluded exercises, with reasons. `ledger` is a REFACTORING kata: its starter is a complete working
// implementation (the task is cleanup with tests staying green), so seed-must-fail scoring can't apply —
// any no-op would "solve" it. Caught by verify-fixtures ("seed unexpectedly PASSED" on the full suite).
const EXCLUDE = new Map<string, string>([['ledger', 'refactoring kata — starter already passes the full suite']])

const practiceDir = join(BENCH, 'javascript', 'exercises', 'practice')
const names = readdirSync(practiceDir)
rmSync(OUT, { recursive: true, force: true })
mkdirSync(OUT, { recursive: true })

let converted = 0
const skipped: string[] = []
for (const name of names) {
	if (EXCLUDE.has(name)) {
		skipped.push(`${name} (${EXCLUDE.get(name)})`)
		continue
	}
	const src = join(practiceDir, name)
	const cfgPath = join(src, '.meta', 'config.json')
	if (!existsSync(cfgPath)) {
		skipped.push(`${name} (no .meta/config.json)`)
		continue
	}
	const cfg = JSON.parse(readFileSync(cfgPath, 'utf8')) as { files: { solution: string[]; test: string[]; example: string[] } }
	const { solution, test, example } = cfg.files
	if (!solution?.length || !test?.length || example?.length !== solution.length) {
		skipped.push(`${name} (unusual file layout)`) // keep the suite sound: every task must be verifiable
		continue
	}

	// Prompt = the exercise docs (introduction + instructions + append, whichever exist) + the task framing
	// the benchmark's own harness uses: implement in the named files, tests are the oracle.
	const docs = ['introduction.md', 'instructions.md', 'instructions.append.md']
		.map((f) => join(src, '.docs', f))
		.filter((p) => existsSync(p))
		.map((p) => readFileSync(p, 'utf8').trim())
		.join('\n\n')
	const prompt = `${docs}

####

Implement the solution in ${solution.join(', ')} (the stub file${solution.length > 1 ? 's' : ''} in this project). Only use standard JavaScript (CommonJS/ESM as the stub is written). Do NOT modify the test files. Run \`node run-tests.mjs\` to check your work; you are done when all tests pass.`

	// repo/: the working copy the agent sees — EVERYTHING except `.meta` (contains the reference solution;
	// leaking it would invalidate the benchmark) and `.docs` (already in the prompt). Cherry-picking files
	// broke js-grep, whose spec depends on auxiliary files outside the config lists.
	const repo = join(OUT, `js-${name}`, 'repo')
	mkdirSync(repo, { recursive: true })
	for (const entry of readdirSync(src)) {
		if (entry === '.meta' || entry === '.docs') continue
		cpSync(join(src, entry), join(repo, entry), { recursive: true })
	}
	// Un-skip the specs (xtest/xit/xdescribe/.skip → active): Exercism ships most tests skipped for students
	// to enable one by one; the stub passes the lone active test (js-ledger seed "passed"). The benchmark's
	// own harness un-skips too — the FULL suite is the oracle.
	for (const t of test) {
		const p = join(repo, t)
		if (!existsSync(p)) continue
		const unskipped = readFileSync(p, 'utf8')
			.replace(/\bxtest\(/g, 'test(')
			.replace(/\bxit\(/g, 'it(')
			.replace(/\bxdescribe\(/g, 'describe(')
			.replace(/\b(test|it|describe)\.skip\(/g, '$1(')
		writeFileSync(p, unskipped)
	}
	writeFileSync(join(repo, 'run-tests.mjs'), runTestsSource)

	// solution/: the reference implementation mapped onto the stub filename(s) — verify-fixtures' proof.
	const solDir = join(OUT, `js-${name}`, 'solution')
	mkdirSync(solDir, { recursive: true })
	example.forEach((ex, i) => cpSync(join(src, ex), join(solDir, solution[i]!)))

	writeFileSync(
		join(OUT, `js-${name}`, 'task.json'),
		`${JSON.stringify(
			{
				id: `js-${name}`,
				tags: ['polyglot', 'js'],
				prompt,
				check: 'node run-tests.mjs',
				budgets: { maxTurns: 24, timeoutMs: 600_000 },
				protected: [...test, 'run-tests.mjs', 'babel.config.js', 'package.json'],
			},
			null,
			'\t',
		)}\n`,
	)
	converted++
}

console.log(`converted ${converted}/${names.length} JS exercises → ${OUT}`)
if (skipped.length) console.log(`skipped: ${skipped.join(', ')}`)
console.log(`\nnext:\n  node eval/verify-fixtures.mjs eval/external/tasks-js     # prove every task is sound`)
console.log(`  npm run eval -- --model <m> --label polyglot-js --tasks-dir eval/external/tasks-js`)
