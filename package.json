{
  "name": "cascade-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Cascade — an Ollama-native AI coding agent. One headless engine, many frontends.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build -w @cascade/core",
    "build:extension": "npm run build -w @cascade/extension",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval/run.mts",
    "eval:report": "tsx scripts/eval/report.mts",
    "eval:verify-fixtures": "node eval/verify-fixtures.mjs",
    "eval:convert-polyglot": "tsx scripts/eval/convert-polyglot.mts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
